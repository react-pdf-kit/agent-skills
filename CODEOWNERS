# CODEOWNERS for @react-pdf-kit/agent-skills
#
# Owners receive review requests automatically for the paths they own.
# Replace the placeholder teams with real GitHub teams or usernames
# (e.g., @react-pdf-kit/maintainers) before enabling branch protection.

# Default: the React PDF Kit maintainers review anything not matched
# more specifically below.
*                                   @react-pdf-kit/maintainers

# Skill content: same owners (skills are the product).
/skills/                            @react-pdf-kit/maintainers

# Sample projects: a dedicated samples team alias (delegate or alias
# to the maintainers team if no separate team exists yet).
/samples/                           @react-pdf-kit/samples-owners

# Conformance & CI tooling: a stricter review surface — owned by the
# infrastructure team to keep gates honest.
/scripts/                           @react-pdf-kit/infra-owners
/.github/                           @react-pdf-kit/infra-owners

# Top-level docs that bind everyone: maintainers must sign off.
/README.md                          @react-pdf-kit/maintainers
/CONTRIBUTING.md                    @react-pdf-kit/maintainers
/MAINTENANCE.md                     @react-pdf-kit/maintainers
/CHANGELOG.md                       @react-pdf-kit/maintainers
/LICENSE                            @react-pdf-kit/maintainers
